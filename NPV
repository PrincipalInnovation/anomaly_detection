noi = [2849656, 2849069, 2848793, 2848778, 2849369, 
       2849512, 2849006, 2848454, 2847919, 2847318]

rate = 0.07
reversion = 88778503

def rolling_npv_excel_style(noi, rate, reversion):
    n = len(noi)
    results = []

    for t in range(n):
        if t == n - 1:
            results.append(reversion)
            continue

        # Excel NPV inputs: future NOI + reversion
        cashflows = noi[t+1:] + [reversion]

        npv = 0.0

        # Excel NPV logic: each CF discounted from next period
        for i, cf in enumerate(cashflows):
            npv += cf / ((1 + rate) ** (i + 1))

        results.append(npv)

    return results


npvs = rolling_npv_excel_style(noi, rate, reversion)

print("length:", len(npvs))
for x in npvs:
    print(x)
